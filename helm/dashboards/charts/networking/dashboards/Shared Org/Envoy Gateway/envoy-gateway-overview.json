      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(envoy_cluster_membership_total{cluster_id=\"$workload_cluster\"}) - sum(envoy_cluster_membership_healthy{cluster_id=\"$workload_cluster\"})",
          "legendFormat": "Unhealthy endpoints",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Unhealthy upstream endpoints",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Share of upstream endpoints that are healthy across all clusters.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",

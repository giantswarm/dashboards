      "pluginVersion": "12.1.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(sum by (cluster_id, name) (policy_report_result{source=\"sbom-advisory-operator\", kind=\"SBOMSyft\", cluster_id=~\"$cluster\", name=~\".*$image.*\", policy=\"$advisory\", status=\"fail\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Images still affected",
      "type": "stat"

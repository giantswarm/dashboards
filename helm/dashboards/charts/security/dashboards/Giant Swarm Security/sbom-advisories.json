  "description": "Images whose SBOM fails an advisory evaluated by sbom-advisory-operator (e.g. the eMudhra CA compromise, October 2026), grouped by the fix. Images are shown as kubescape SBOM slugs (registry/repo:tag with / : @ _ replaced by -, plus a short digest suffix). Workloads are not mapped yet.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "mappings": [],
          "noValue": "0",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false

      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(count by (user) (increase(agentgateway_requests_total{gateway=~\"$gateway\", route=~\"$route\", agent=~\"$caller\", user=~\"$user\", user!=\"unknown\"}[$__range]) > 0))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"

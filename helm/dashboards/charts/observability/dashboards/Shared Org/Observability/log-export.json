                      "spec": {
                        "expr": "clamp_min(scalar(sum(rate(loki_source_api_entries_written{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\"}[$__rate_interval]))) - sum by (export) (label_replace(rate(loki_process_dropped_lines_total{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"loki\\\\.process\\\\.select_(${export:regex})\"}[$__rate_interval]), \"export\", \"$1\", \"component_id\", \"loki\\\\.process\\\\.select_(.*)\")), 0)",
                        "legendFormat": "{{export}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Lines that match the export's selector. Zero means the selector matches nothing the exporter receives.",
          "id": 5,
          "links": [],
          "title": "Lines selected",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {

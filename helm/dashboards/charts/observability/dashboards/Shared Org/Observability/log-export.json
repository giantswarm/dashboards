{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "log-export",
    "namespace": "default",
    "uid": "log-export"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "legacyOptions": {
            "type": "dashboard"
          },
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Log export to S3 (LogExport): intake from the Loki write path, selection and upload per export.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "clamp_min(scalar(sum(increase(loki_source_api_entries_written{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\"}[$__range]))) - sum by (export) (label_replace(increase(loki_process_dropped_lines_total{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"loki\\\\.process\\\\.select_(${export:regex})\"}[$__range]), \"export\", \"$1\", \"component_id\", \"loki\\\\.process\\\\.select_(.*)\")), 0)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(sum by (export) (label_replace(increase(otelcol_exporter_sent_log_records_total{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\"}[$__range]), \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))) or sum by (export) (label_replace(0 * otelcol_exporter_queue_capacity{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\", data_type=\"logs\"}, \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(sum by (export) (label_replace(increase({__name__=~\"otelcol_exporter_(send|enqueue)_failed_log_records_total\", job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\"}[$__range]), \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))) or sum by (export) (label_replace(0 * otelcol_exporter_queue_capacity{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\", data_type=\"logs\"}, \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (export) (label_replace(otelcol_exporter_queue_size{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\", data_type=\"logs\"} / otelcol_exporter_queue_capacity{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\", data_type=\"logs\"}, \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "joinByField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "byField": "export",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true,
                        "Time 4": true
                      },
                      "indexByName": {
                        "Value #A": 1,
                        "Value #B": 2,
                        "Value #C": 3,
                        "Value #D": 4,
                        "export": 0
                      },
                      "renameByName": {
                        "Value #A": "Lines selected",
                        "Value #B": "Records uploaded",
                        "Value #C": "Records lost",
                        "Value #D": "Queue fill",
                        "export": "Export"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "One row per LogExport, named <namespace>_<name>. Totals cover the selected time range.",
          "id": 1,
          "links": [],
          "title": "Exports",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto"
                  },
                  "decimals": 0,
                  "unit": "short"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Queue fill"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percentunit"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Records lost"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "text"
                            },
                            {
                              "color": "red",
                              "value": 1
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Export"
                  }
                ]
              }
            },
            "version": ""
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum(rate(loki_source_api_entries_written{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\"}[$__rate_interval]))",
                        "legendFormat": "received",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Log lines the exporter receives from the Loki write path, before any selector. Every export sees the same lines.",
          "id": 2,
          "links": [],
          "title": "Lines received",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisLabel": "lines/s",
                    "axisSoftMin": 0,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "min": 0,
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": ""
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (status_code) (rate(loki_source_api_request_duration_seconds_count{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=\"loki.source.api.mirror\", route=\"loki_api_v1_push\"}[$__rate_interval]))",
                        "legendFormat": "{{status_code}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Push requests the exporter answers, by HTTP status. A non-2xx status means the batch never reached any export.",
          "id": 3,
          "links": [],
          "title": "Pushes received, by status",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisLabel": "",
                    "axisSoftMin": 0,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "min": 0,
                  "unit": "reqps"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "2.."
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "[45].."
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": ""
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum(rate(envoy_cluster_upstream_rq_xx{cluster_id=\"$cluster_id\", envoy_cluster_name=~\"httproute/loki/loki-gateway/rule/[0-9]+-mirror-[0-9]+\", envoy_response_code_class=\"5\"}[$__rate_interval]))",
                        "legendFormat": "5xx",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Requests Envoy failed to mirror to the exporter. The lines in them are missing from every export. Envoy never retries a mirrored request.",
          "id": 4,
          "links": [],
          "title": "Mirror requests failed (5xx)",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisLabel": "",
                    "axisSoftMin": 0,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "min": 0,
                  "noValue": "0",
                  "unit": "reqps"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "5xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": ""
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {

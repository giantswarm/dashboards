                        "expr": "(sum by (export) (label_replace(rate(otelcol_exporter_sent_log_records_total{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\"}[$__rate_interval]), \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))) or sum by (export) (label_replace(0 * otelcol_exporter_queue_capacity{job=\"alloy-logexporter\", cluster_id=\"$cluster_id\", component_id=~\"otelcol\\\\.exporter\\\\.awss3\\\\.(${export:regex})\", data_type=\"logs\"}, \"export\", \"$1\", \"component_id\", \"otelcol\\\\.exporter\\\\.awss3\\\\.(.*)\"))",
